<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Privacy Policy — {{ site.company_name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=SF+Pro+Display:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;400;500;600;700&family=Fraunces:ital,wght@0,200;0,300;0,400;1,200;1,300&display=swap');
    :root {
      --eggshell: #F4F1EC;
      --eggshell-dark: #EAE5DC;
      --eggshell-deeper: #DDD8CE;
      --cobalt: #0B476C;
      --cobalt-mid: #011936;
      --cobalt-light: #777DA7;
      --cobalt-glow: rgba(26, 58, 107, 0.15);
      --sage: #4A7C6F;
      --sage-light: #6BA898;
      --glass-white: rgba(255, 255, 255, 0.55);
      --glass-eggshell: rgba(244, 241, 236, 0.65);
      --glass-border: rgba(255, 255, 255, 0.7);
      --glass-shadow: rgba(26, 58, 107, 0.12);
      --text-primary: #1A1A2E;
      --text-secondary: #4A4A6A;
      --text-muted: #8A8AA8;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Outfit', sans-serif;
      background-color: var(--eggshell);
      color: var(--text-primary);
      overflow-x: hidden;
      min-height: 100vh;
    }
    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 0 32px;
    }
    .section-title {
      font-family: 'Fraunces', serif;
      font-size: 2.2rem;
      font-weight: 300;
      margin-top: 80px;
      margin-bottom: 24px;
      color: #0B476C;
      letter-spacing: -0.02em;
    }
    .section-sub {
      font-size: 1.05rem;
      font-weight: 300;
      color: #4A4A6A;
      margin-bottom: 40px;
      line-height: 1.65;
    }
    .privacy-content {
      background: rgba(255,255,255,0.55);
      border-radius: 24px;
      padding: 40px;
      margin-bottom: 60px;
      box-shadow: 0 8px 32px rgba(26,58,107,0.08);
      border: 1px solid rgba(255,255,255,0.8);
    }
    h2 {
      font-size: 1.3rem;
      font-weight: 500;
      color: #0B476C;
      margin-top: 32px;
      margin-bottom: 12px;
    }
    p {
      font-size: 1rem;
      font-weight: 300;
      color: #4A4A6A;
      margin-bottom: 18px;
      line-height: 1.7;
    }
    ul {
      margin-bottom: 18px;
      padding-left: 20px;
      color: #4A4A6A;
      font-size: 1rem;
      font-weight: 300;
    }
    
  /* ── FOOTER ── */
  footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid #0B476C--- /* 0.08 */;
    padding: 48px 0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-logo {
    font-family: 'Fraunces', serif;
    font-size: 1.2rem;
    font-weight: 300;
    font-style: italic;
    color: var(--cobalt);
  }

  .footer-logo span { font-weight: 600; font-style: normal; }

  .footer-logo img {
    height: 28px;
    width: auto;
  }

  .footer-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }

  .footer-links a {
    font-size: 0.82rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 300;
    transition: color 0.2s;
  }

  .footer-links a:hover { color: var(--cobalt); }

  .footer-copy {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 300;
  }
    /* Background canvas styles */
    .bg-canvas {
      position: fixed;
      inset: 0;
      z-index: 0;
      background: var(--eggshell);
      overflow: hidden;
    }
    .bg-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.35;
      animation: drift 18s ease-in-out infinite alternate;
    }
    .bg-blob-1 {
      width: 700px; height: 700px;
      background: radial-gradient(circle, var(--cobalt-light), var(--cobalt));
      top: -200px; right: -150px;
      animation-delay: 0s;
    }
    .bg-blob-2 {
      width: 500px; height: 500px;
      background: radial-gradient(circle, var(--sage-light), var(--sage));
      bottom: 100px; left: -100px;
      animation-delay: -6s;
    }
    .bg-blob-3 {
      width: 400px; height: 400px;
      background: radial-gradient(circle, var(--cobalt-mid), transparent);
      top: 50%; left: 40%;
      animation-delay: -12s;
    }
    .bg-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(#0B476C--- /* 0.04 */ 1px, transparent 1px),
        linear-gradient(90deg, #0B476C--- /* 0.04 */ 1px, transparent 1px);
      background-size: 60px 60px;
    }
    @keyframes drift {
      from { transform: translate(0, 0) scale(1); }
      to   { transform: translate(40px, 30px) scale(1.08); }
    }
  </style>
</head>
<body>
  <!-- Background canvas -->
  
  <div class="container">
    <div class="container-inner">
      {% for section in privacy.sections %}
        <h2>{{ section.title }}</h2>
        <p>{{ section.content }}</p>
      {% endfor %}
    </div>
  </div>
  
  
<!-- Footer -->
<footer>
  <div class="container">
    <div class="footer-inner">
      <div class="footer-logo">
        {% if site.logo_url %}
          <img src="{{ site.logo_url }}" alt="{{ site.company_name }} logo">
        {% else %}
          <span>{{ site.company_name }}</span>
        {% endif %}
      </div>
      <ul class="footer-links">
        <li><a href="/">Return Home</a></li>
        {% for link in footer.links %}
        <li><a href="{{ link.url }}">{{ link.label }}</a></li>
        {% endfor %}
      </ul>
      <div class="footer-copy">{{ footer.copyright }}</div>
    </div>
  </div>
</footer>
</body>
</html>
