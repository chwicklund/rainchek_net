<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.company_name }} — {{ site.tagline }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=SF+Pro+Display:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;400;500;600;700&family=Fraunces:ital,wght@0,200;0,300;0,400;1,200;1,300&display=swap');

  :root {
    --eggshell: #F4F1EC;
    --eggshell-dark: #EAE5DC;
    --eggshell-deeper: #DDD8CE;
    --cobalt: #0B476C;
    --cobalt-mid: #011936;
    --cobalt-light: #777DA7;
    --cobalt-glow: rgba(26, 58, 107, 0.15);
    --sage: #4A7C6F;
    --sage-light: #6BA898;
    --glass-white: rgba(255, 255, 255, 0.55);
    --glass-eggshell: rgba(244, 241, 236, 0.65);
    --glass-border: rgba(255, 255, 255, 0.7);
    --glass-shadow: rgba(26, 58, 107, 0.12);
    --text-primary: #1A1A2E;
    --text-secondary: #4A4A6A;
    --text-muted: #8A8AA8;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Outfit', sans-serif;
    background-color: var(--eggshell);
    color: var(--text-primary);
    overflow-x: hidden;
    min-height: 100vh;
  }

  /* ── BACKGROUND CANVAS ── */
  .bg-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: var(--eggshell);
    overflow: hidden;
  }

  .bg-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.35;
    animation: drift 18s ease-in-out infinite alternate;
  }

  .bg-blob-1 {
    width: 700px; height: 700px;
    background: radial-gradient(circle, var(--cobalt-light), var(--cobalt));
    top: -200px; right: -150px;
    animation-delay: 0s;
  }

  .bg-blob-2 {
    width: 500px; height: 500px;
    background: radial-gradient(circle, var(--sage-light), var(--sage));
    bottom: 100px; left: -100px;
    animation-delay: -6s;
  }

  .bg-blob-3 {
    width: 400px; height: 400px;
    background: radial-gradient(circle, var(--cobalt-mid), transparent);
    top: 50%; left: 40%;
    animation-delay: -12s;
  }

  .bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(#0B476C--- /* 0.04 */ 1px, transparent 1px),
      linear-gradient(90deg, #0B476C--- /* 0.04 */ 1px, transparent 1px);
    background-size: 60px 60px;
  }

  @keyframes drift {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(40px, 30px) scale(1.08); }
  }

  /* ── GLASS MIXIN ── */
  .glass {
    background: var(--glass-white);
    backdrop-filter: blur(24px) saturate(1.8) brightness(1.05);
    -webkit-backdrop-filter: blur(24px) saturate(1.8) brightness(1.05);
    border: 1px solid var(--glass-border);
    box-shadow:
      0 8px 32px var(--glass-shadow),
      inset 0 1px 0 rgba(255,255,255,0.8),
      inset 0 -1px 0 rgba(255,255,255,0.3);
  }

  .glass-strong {
    background: rgba(255,255,255,0.72);
    backdrop-filter: blur(40px) saturate(2) brightness(1.08);
    -webkit-backdrop-filter: blur(40px) saturate(2) brightness(1.08);
    border: 1px solid rgba(255,255,255,0.85);
    box-shadow:
      0 16px 48px var(--glass-shadow),
      inset 0 2px 0 rgba(255,255,255,0.9),
      inset 0 -1px 0 rgba(255,255,255,0.4);
  }

  /* ── LAYOUT ── */
  .container {
    position: relative;
    z-index: 1;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 32px;
  }

  section { position: relative; z-index: 1; }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    width: calc(100% - 64px);
    max-width: 1100px;
    border-radius: 20px;
    padding: 14px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255,255,255,0.68);
    backdrop-filter: blur(32px) saturate(2);
    -webkit-backdrop-filter: blur(32px) saturate(2);
    border: 1px solid rgba(255,255,255,0.85);
    box-shadow:
      0 4px 24px #0B476C--- /* 0.1 */,
      inset 0 1px 0 rgba(255,255,255,0.9);
    animation: slideDown 0.7s cubic-bezier(0.34,1.56,0.64,1) both;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateX(-50%) translateY(-20px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  .nav-logo {
    font-family: 'Fraunces', serif;
    font-size: 1.35rem;
    font-weight: 300;
    font-style: italic;
    color: var(--cobalt);
    letter-spacing: -0.02em;
  }

  .nav-logo span {
    font-weight: 600;
    font-style: normal;
  }

  .nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }

  .nav-links a {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
    letter-spacing: 0.01em;
  }

  .nav-links a:hover { color: var(--cobalt); }

  .nav-cta {
    background: var(--cobalt);
    color: white !important;
    padding: 8px 20px;
    border-radius: 10px;
    font-weight: 500 !important;
    font-size: 0.875rem;
    text-decoration: none;
    transition: all 0.2s;
    box-shadow: 0 2px 12px #0B476C--- /* 0.3 */;
  }

  .nav-cta:hover {
    background: var(--cobalt-mid) !important;
    color: white !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px #0B476C--- /* 0.4 */;
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 140px 0 80px;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 8px;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--cobalt);
    margin-bottom: 24px;
    animation: fadeUp 0.8s 0.2s both;
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.85);
    box-shadow: 0 2px 12px #0B476C--- /* 0.08 */;
  }

  .badge-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--sage);
    box-shadow: 0 0 0 3px rgba(74,124,111,0.2);
    animation: pulse 2s ease infinite;
  }

  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(74,124,111,0.2); }
    50% { box-shadow: 0 0 0 6px rgba(74,124,111,0.1); }
  }

  .hero h1 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 24px;
    animation: fadeUp 0.8s 0.3s both;
  }

  .hero h1 em {
    font-style: italic;
    color: var(--cobalt);
  }

  .hero p {
    font-size: 1.1rem;
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 40px;
    animation: fadeUp 0.8s 0.4s both;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    animation: fadeUp 0.8s 0.5s both;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--cobalt);
    color: white;
    padding: 14px 28px;
    border-radius: 14px;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.34,1.56,0.64,1);
    box-shadow: 0 4px 20px #0B476C--- /* 0.35 */;
  }

  .btn-primary:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 28px #0B476C--- /* 0.45 */;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    padding: 14px 24px;
    border-radius: 14px;
    font-size: 0.95rem;
    font-weight: 400;
    text-decoration: none;
    transition: all 0.2s;
    background: rgba(255,255,255,0.5);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.8);
  }

  .btn-ghost:hover {
    color: var(--cobalt);
    background: rgba(255,255,255,0.75);
  }

  /* Hero card */
  .hero-card {
    border-radius: 28px;
    padding: 32px;
    animation: fadeUp 0.9s 0.4s both;
    background: rgba(255,255,255,0.62);
    backdrop-filter: blur(32px) saturate(1.9);
    -webkit-backdrop-filter: blur(32px) saturate(1.9);
    border: 1px solid rgba(255,255,255,0.82);
    box-shadow:
      0 20px 60px #0B476C--- /* 0.12 */,
      inset 0 2px 0 rgba(255,255,255,0.9),
      inset 0 -1px 0 rgba(255,255,255,0.4);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .card-title-sm { font-size: 0.75rem; font-weight: 500; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.1em; }

  .card-dots { display: flex; gap: 6px; }
  .card-dot { width: 8px; height: 8px; border-radius: 50%; }
  .cd-red { background: #FF6B6B; }
  .cd-yellow { background: #FFD93D; }
  .cd-green { background: #6BCB77; }

  .metric-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }

  .metric-card {
    border-radius: 16px;
    padding: 18px;
    background: rgba(244,241,236,0.7);
    border: 1px solid rgba(255,255,255,0.7);
    backdrop-filter: blur(12px);
  }

  .metric-val { font-family: 'Fraunces', serif; font-size: 1.8rem; font-weight: 300; color: var(--cobalt); }
  .metric-label { font-size: 0.72rem; color: var(--text-muted); font-weight: 400; margin-top: 2px; }
  .metric-change { font-size: 0.72rem; color: var(--sage); font-weight: 500; margin-top: 4px; }

  .chart-area {
    height: 80px;
    border-radius: 12px;
    background: linear-gradient(135deg, #0B476C--- /* 0.07 */, rgba(74,124,111,0.07));
    display: flex;
    align-items: flex-end;
    padding: 10px;
    gap: 5px;
    border: 1px solid rgba(255,255,255,0.6);
  }

  .bar {
    flex: 1;
    border-radius: 4px 4px 0 0;
    transition: all 0.3s;
    background: linear-gradient(to top, var(--cobalt), var(--cobalt-light));
    opacity: 0.7;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── LOGOS ── */
  .logos-strip {
    padding: 60px 0;
  }

  .logos-inner {
    border-radius: 20px;
    padding: 28px 40px;
    background: rgba(255,255,255,0.5);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.75);
    box-shadow: 0 4px 20px #0B476C--- /* 0.06 */;
    text-align: center;
  }

  .logos-label {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 500;
    margin-bottom: 20px;
  }

  .logos-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 48px;
    flex-wrap: wrap;
  }

  .logo-item {
    font-family: 'Fraunces', serif;
    font-size: 1.1rem;
    font-weight: 300;
    color: var(--text-muted);
    opacity: 0.65;
    font-style: italic;
    transition: opacity 0.2s;
  }

  .logo-item img {
    height: 24px;
    width: auto;
    opacity: 0.5;
    filter: grayscale(1);
    transition: opacity 0.2s, filter 0.2s;
  }

  .logo-item:hover { opacity: 1; }
  .logo-item:hover img { opacity: 0.8; filter: grayscale(0.3); }

  /* ── FEATURES ── */
  .features { padding: 100px 0; }

  .section-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--cobalt-mid);
    margin-bottom: 16px;
  }

  .section-title {
    font-family: 'Fraunces', serif;
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 16px;
  }

  .section-title em { font-style: italic; color: var(--cobalt); }

  .section-sub {
    font-size: 1.05rem;
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 520px;
    margin-bottom: 64px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .feature-card {
    border-radius: 24px;
    padding: 32px;
    transition: all 0.3s cubic-bezier(0.34,1.2,0.64,1);
    background: rgba(255,255,255,0.55);
    backdrop-filter: blur(24px) saturate(1.8);
    -webkit-backdrop-filter: blur(24px) saturate(1.8);
    border: 1px solid rgba(255,255,255,0.8);
    box-shadow: 0 8px 32px #0B476C--- /* 0.08 */, inset 0 1px 0 rgba(255,255,255,0.85);
  }

  .feature-card:hover {
    transform: translateY(-6px) scale(1.01);
    box-shadow: 0 20px 48px #0B476C--- /* 0.14 */, inset 0 1px 0 rgba(255,255,255,0.9);
    background: rgba(255,255,255,0.72);
  }

  .feature-icon {
    width: 48px; height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    margin-bottom: 20px;
    background: linear-gradient(135deg, #0B476C--- /* 0.12 */, rgba(74,127,212,0.08));
    border: 1px solid rgba(255,255,255,0.7);
    backdrop-filter: blur(8px);
  }

  .feature-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }

  .feature-desc {
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* ── BIG FEATURE ── */
  .big-feature { padding: 80px 0; }

  .big-feature-inner {
    border-radius: 32px;
    padding: 64px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    background: #0B476C--- /* 0.06 */;
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255,255,255,0.75);
    box-shadow: 0 16px 48px #0B476C--- /* 0.1 */, inset 0 1px 0 rgba(255,255,255,0.8);
    overflow: hidden;
    position: relative;
  }

  .big-feature-inner::before {
    content: '';
    position: absolute;
    top: -80px; right: -80px;
    width: 300px; height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(74,127,212,0.15), transparent 70%);
    pointer-events: none;
  }

  .big-feature-visual {
    border-radius: 20px;
    padding: 28px;
    background: rgba(255,255,255,0.65);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.85);
    box-shadow: 0 8px 32px #0B476C--- /* 0.1 */;
  }

  .vis-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid #0B476C--- /* 0.06 */;
  }
  .vis-row:last-child { border-bottom: none; }

  .vis-avatar {
    width: 32px; height: 32px;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 600;
    color: white;
  }

  .vis-avatar img { width: 100%; height: 100%; object-fit: cover; }

  .vis-info { flex: 1; }
  .vis-name { font-size: 0.8rem; font-weight: 500; color: var(--text-primary); }
  .vis-sub { font-size: 0.7rem; color: var(--text-muted); font-weight: 300; }

  .vis-tag {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 100px;
    border: 1px solid;
  }

  .tag-blue { background: #0B476C--- /* 0.08 */; color: var(--cobalt); border-color: #0B476C--- /* 0.2 */; }
  .tag-green { background: rgba(74,124,111,0.08); color: var(--sage); border-color: rgba(74,124,111,0.2); }
  .tag-amber { background: rgba(180,130,40,0.08); color: #7A5C10; border-color: rgba(180,130,40,0.2); }

  /* ── PRICING ── */
  .pricing { padding: 100px 0; }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 60px;
  }

  .pricing-card {
    border-radius: 28px;
    padding: 36px 32px;
    transition: all 0.3s;
    background: rgba(255,255,255,0.5);
    backdrop-filter: blur(24px) saturate(1.8);
    border: 1px solid rgba(255,255,255,0.75);
    box-shadow: 0 8px 32px #0B476C--- /* 0.07 */;
  }

  .pricing-card.featured {
    background: #0B476C--- /* 0.9 */;
    backdrop-filter: blur(32px);
    border-color: rgba(74,127,212,0.4);
    box-shadow: 0 20px 60px #0B476C--- /* 0.35 */, inset 0 1px 0 rgba(255,255,255,0.15);
    transform: scale(1.04);
  }

  .pricing-card:hover:not(.featured) {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px #0B476C--- /* 0.12 */;
  }

  .plan-name {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .featured .plan-name { color: rgba(255,255,255,0.6); }

  .plan-price {
    font-family: 'Fraunces', serif;
    font-size: 3rem;
    font-weight: 300;
    color: var(--text-primary);
    line-height: 1;
    margin-bottom: 4px;
  }

  .featured .plan-price { color: white; }

  .plan-price sup { font-size: 1.2rem; vertical-align: super; }
  .plan-period { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 24px; }
  .featured .plan-period { color: rgba(255,255,255,0.5); }

  .plan-divider {
    height: 1px;
    background: #0B476C--- /* 0.08 */;
    margin: 20px 0;
  }
  .featured .plan-divider { background: rgba(255,255,255,0.12); }

  .plan-features { list-style: none; margin-bottom: 32px; }

  .plan-features li {
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--text-secondary);
    padding: 7px 0;
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .featured .plan-features li { color: rgba(255,255,255,0.8); }

  .plan-features li::before {
    content: '✓';
    color: var(--sage);
    font-weight: 600;
    font-size: 0.8rem;
    margin-top: 1px;
    flex-shrink: 0;
  }

  .featured .plan-features li::before { color: var(--sage-light); }

  .plan-btn {
    display: block;
    text-align: center;
    padding: 13px;
    border-radius: 14px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.34,1.3,0.64,1);
    background: rgba(255,255,255,0.55);
    border: 1px solid rgba(255,255,255,0.8);
    color: var(--cobalt);
    backdrop-filter: blur(8px);
  }

  .plan-btn:hover {
    background: rgba(255,255,255,0.85);
    transform: translateY(-1px);
  }

  .featured .plan-btn {
    background: white;
    color: var(--cobalt);
    border-color: transparent;
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
  }

  .featured .plan-btn:hover {
    background: var(--eggshell);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
  }

  /* ── TESTIMONIALS ── */
  .testimonials { padding: 80px 0; }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 56px;
  }

  .testimonial-card {
    border-radius: 24px;
    padding: 32px;
    background: rgba(255,255,255,0.55);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255,255,255,0.8);
    box-shadow: 0 8px 28px #0B476C--- /* 0.07 */;
    transition: all 0.3s;
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px #0B476C--- /* 0.11 */;
  }

  .stars { color: #E8B84B; font-size: 0.85rem; margin-bottom: 16px; letter-spacing: 2px; }

  .testimonial-text {
    font-size: 0.92rem;
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 20px;
    font-style: italic;
  }

  .testimonial-author { display: flex; gap: 12px; align-items: center; }

  .author-avatar {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--cobalt-light), var(--sage));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: white;
    overflow: hidden;
    flex-shrink: 0;
  }

  .author-avatar img { width: 100%; height: 100%; object-fit: cover; }

  .author-name { font-size: 0.85rem; font-weight: 600; color: var(--text-primary); }
  .author-role { font-size: 0.75rem; color: var(--text-muted); font-weight: 300; }

  /* ── CTA ── */
  .cta-section { padding: 80px 0 120px; }

  .cta-inner {
    border-radius: 32px;
    padding: 80px 64px;
    text-align: center;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #0B476C--- /* 0.88 */, rgba(43,91,168,0.82));
    backdrop-filter: blur(32px);
    border: 1px solid rgba(74,127,212,0.3);
    box-shadow:
      0 24px 80px #0B476C--- /* 0.35 */,
      inset 0 1px 0 rgba(255,255,255,0.15);
  }

  .cta-inner::before {
    content: '';
    position: absolute;
    top: -100px; right: -60px;
    width: 400px; height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(74,127,212,0.3), transparent 70%);
  }

  .cta-inner::after {
    content: '';
    position: absolute;
    bottom: -80px; left: -80px;
    width: 300px; height: 300px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(74,124,111,0.25), transparent 70%);
  }

  .cta-inner h2 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 300;
    color: white;
    line-height: 1.15;
    margin-bottom: 20px;
    position: relative;
    z-index: 1;
    letter-spacing: -0.03em;
  }

  .cta-inner h2 em { font-style: italic; opacity: 0.8; }

  .cta-inner p {
    font-size: 1.05rem;
    font-weight: 300;
    color: rgba(255,255,255,0.7);
    margin-bottom: 40px;
    position: relative;
    z-index: 1;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.65;
  }

  .cta-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .btn-white {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: white;
    color: var(--cobalt);
    padding: 15px 32px;
    border-radius: 14px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.34,1.3,0.64,1);
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }

  .btn-white:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 32px rgba(0,0,0,0.22);
  }

  .btn-outline-white {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.12);
    color: white;
    padding: 15px 32px;
    border-radius: 14px;
    font-size: 0.95rem;
    font-weight: 400;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.3);
    backdrop-filter: blur(8px);
    transition: all 0.2s;
  }

  .btn-outline-white:hover {
    background: rgba(255,255,255,0.2);
    border-color: rgba(255,255,255,0.5);
  }

  /* ── FOOTER ── */
  footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid #0B476C--- /* 0.08 */;
    padding: 48px 0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-logo {
    font-family: 'Fraunces', serif;
    font-size: 1.2rem;
    font-weight: 300;
    font-style: italic;
    color: var(--cobalt);
  }

  .footer-logo span { font-weight: 600; font-style: normal; }

  .footer-logo img {
    height: 28px;
    width: auto;
  }

  .footer-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }

  .footer-links a {
    font-size: 0.82rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 300;
    transition: color 0.2s;
  }

  .footer-links a:hover { color: var(--cobalt); }

  .footer-copy {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 300;
  }

  /* ── SCROLL ANIMATIONS ── */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.34,1.2,0.64,1);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; }
    .features-grid, .pricing-grid, .testimonials-grid { grid-template-columns: 1fr; }
    .big-feature-inner { grid-template-columns: 1fr; padding: 40px 32px; }
    .pricing-card.featured { transform: none; }
    nav { width: calc(100% - 32px); }
    .nav-links { display: none; }
    .cta-inner { padding: 56px 32px; }
    .footer-inner { flex-direction: column; gap: 24px; text-align: center; }
    .cta-actions { flex-direction: column; align-items: center; }
  }
</style>
</head>
<body>

<!-- Background canvas -->
<div class="bg-canvas">
  <div class="bg-blob bg-blob-1"></div>
  <div class="bg-blob bg-blob-2"></div>
  <div class="bg-blob bg-blob-3"></div>
  <div class="bg-grid"></div>
</div>

<!-- Navigation -->
<nav>
  <div class="nav-logo">
    {% if site.logo_url %}
      <img src="{{ site.logo_url }}" style="height: 40px; width: auto;" alt="{{ site.company_name }} logo">
    {% else %}
      <span>{{ site.company_name }}</span>
    {% endif %}
  </div>
  <ul class="nav-links">
    {% for link in nav.links %}
    <li><a href="{{ link.url }}">{{ link.label }}</a></li>
    {% endfor %}
  </ul>
  <a href="{{ nav.cta.url }}" class="nav-cta">{{ nav.cta.label }}</a>
</nav>

<!-- Hero -->
<section class="hero">
  <div class="container">
    <div class="hero-inner">
      <div class="hero-content">
        <!--div class="hero-badge">
          <span class="badge-dot"></span>
          {{ hero.badge_text }}
        </div-->
        <h1>{{ hero.headline | safe }}</h1>
        <p>{{ hero.subheadline }}</p>
        <div class="hero-actions">
          <a href="{{ hero.primary_cta.url }}" class="btn-primary">{{ hero.primary_cta.label }} →</a>
          <a href="{{ hero.secondary_cta.url }}" class="btn-ghost">{{ hero.secondary_cta.label }}</a>
        </div>
      </div>
      <!--div class="hero-card"-->
      <img src="{{ hero.concert_stock_photo.url }}" alt="{{ hero.concert_stock_photo.alt }}" style="{{ hero.concert_stock_photo.style }}">
        <!--div class="card-header">
          <span class="card-title-sm">{{ hero.dashboard.title }}</span>
          <div class="card-dots">
            <div class="card-dot cd-red"></div>
            <div class="card-dot cd-yellow"></div>
            <div class="card-dot cd-green"></div>
          </div>
        </div>
        <div class="metric-grid">
          {% for metric in hero.dashboard.metrics %}
          <div class="metric-card">
            <div class="metric-val">{{ metric.value }}</div>
            <div class="metric-label">{{ metric.label }}</div>
            <div class="metric-change">{{ metric.change }}</div>
          </div>
          {% endfor %}
        </div>
        <div class="chart-area">
          {% for bar in hero.dashboard.chart_bars %}
          <div class="bar" style="height:{{ bar }}%"></div>
          {% endfor %}
        </div-->
      <!--/div>-->
    </div>
  </div>
</section>

<!-- Logos / Social Proof -->
<section class="logos-strip">
  <div class="container">
    <div class="logos-inner reveal">
      <div class="logos-label">{{ logos.label }}</div>
      <div class="logos-row">
        {% for customer in logos.customers %}
        <div class="logo-item">
          {% if customer.logo_url %}
            <img src="{{ customer.logo_url }}" alt="{{ customer.name }}">
          {% else %}
            {{ customer.name }}
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<!-- Features -->
<section class="features" id="features">
  <div class="container">
    <span class="section-label reveal">{{ features.section_label }}</span>
    <h2 class="section-title reveal">{{ features.headline | safe }}</h2>
    <p class="section-sub reveal">{{ features.subheadline }}</p>
    <div class="features-grid">
      {% for feature in features.subjects %}
      <div class="feature-card reveal">
        <div class="feature-icon">{{ feature.icon }}</div>
        <div class="feature-name">{{ feature.name }}</div>
        <div class="feature-desc">{{ feature.description }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Platform / Big Feature -->
<!-- section class="big-feature" id="platform">
  <div class="container">
    <div class="big-feature-inner reveal">
      <div>
        <span class="section-label" style="color:rgba(255,255,255,0.6)">{{ platform.section_label }}</span>
        <h2 class="section-title" style="color:var(--cobalt); font-size:2.2rem;">{{ platform.headline | safe }}</h2>
        <p style="font-size:0.95rem;font-weight:300;color:var(--text-secondary);line-height:1.7;margin-bottom:32px;">{{ platform.body_paragraph_1 }}</p>
        <p style="font-size:0.95rem;font-weight:300;color:var(--text-secondary);line-height:1.7;margin-bottom:36px;">{{ platform.body_paragraph_2 }}</p>
        <a href="{{ platform.cta.url }}" class="btn-primary" style="display:inline-flex;">{{ platform.cta.label }} →</a>
      </div>
      <div class="big-feature-visual">
        {% for row in platform.customer_rows %}
        <div class="vis-row">
          <div class="vis-avatar" style="background:{{ row.avatar_gradient }}">
            {% if row.avatar_url %}
              <img src="{{ row.avatar_url }}" alt="{{ row.name }}">
            {% else %}
              {{ row.initials }}
            {% endif %}
          </div>
          <div class="vis-info">
            <div class="vis-name">{{ row.name }}</div>
            <div class="vis-sub">{{ row.meta }}</div>
          </div>
          <span class="vis-tag tag-{{ row.tag_style }}">{{ row.tag_label }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section -->

<!-- Pricing -->
<section class="pricing" id="pricing">
  <div class="container">
    <div style="text-align:center">
      <span class="section-label reveal">{{ pricing.section_label }}</span>
      <h2 class="section-title reveal" style="margin-bottom:12px;">{{ pricing.headline | safe }}</h2>
      <p style="font-size:1rem;font-weight:300;color:var(--text-secondary);max-width:480px;margin:0 auto;" class="reveal">{{ pricing.subheadline }}</p>
    </div>
    <div class="pricing-grid reveal">
      {% for plan in pricing.plans %}
      <div class="pricing-card{% if plan.featured %} featured{% endif %}">
        <div class="plan-name">{{ plan.name }}</div>
        <div class="plan-price">
          {% if plan.price_prefix %}<sup>{{ plan.price_prefix }}</sup>{% endif %}{{ plan.price }}
        </div>
        <div class="plan-period">{{ plan.period }}</div>
        <div class="plan-divider"></div>
        <ul class="plan-features">
          {% for item in plan.features %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
        <a href="{{ plan.cta.url }}" class="plan-btn">{{ plan.cta.label }}</a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>


<!-- CTA -->
<section class="cta-section">
  <div class="container">
    <div class="cta-inner reveal">
      <h2>{{ cta.headline | safe }}</h2>
      <p>{{ cta.subheadline }}</p>
      <div class="cta-actions">
        <a href="{{ cta.primary.url }}" class="btn-white">{{ cta.primary.label }}</a>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer>
  <div class="container">
    <div class="footer-inner">
      <div class="footer-logo">
        {% if site.logo_url %}
          <img src="{{ site.logo_url }}" alt="{{ site.company_name }} logo">
        {% else %}
          <span>{{ site.company_name }}</span>
        {% endif %}
      </div>
      <ul class="footer-links">
        {% for link in footer.links %}
        <li><a href="{{ link.url }}">{{ link.label }}</a></li>
        {% endfor %}
      </ul>
      <div class="footer-copy">{{ footer.copyright }}</div>
    </div>
  </div>
</footer>

<script>
  // Scroll reveal
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(entries => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.classList.add('visible'), i * 60);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

  reveals.forEach(el => observer.observe(el));

  // Bar chart hover
  document.querySelectorAll('.bar').forEach(bar => {
    bar.addEventListener('mouseover', () => bar.style.opacity = '1');
    bar.addEventListener('mouseout', () => bar.style.opacity = '0.7');
  });
</script>

</body>
</html>
