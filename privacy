  /* ── FOOTER ── */
  footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid #0B476C--- /* 0.08 */;
    padding: 48px 0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-logo {
    font-family: 'Fraunces', serif;
    font-size: 1.2rem;
    font-weight: 300;
    font-style: italic;
    color: var(--cobalt);
  }

  .footer-logo span { font-weight: 600; font-style: normal; }

  .footer-logo img {
    height: 28px;
    width: auto;
  }

  .footer-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }

  .footer-links a {
    font-size: 0.82rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 300;
    transition: color 0.2s;
  }

  .footer-links a:hover { color: var(--cobalt); }

  .footer-copy {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 300;
  }
    /* Background canvas styles */
    .bg-canvas {
      position: fixed;
      inset: 0;
      z-index: 0;
      background: var(--eggshell);
      overflow: hidden;
    }
    .bg-blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.35;
      animation: drift 18s ease-in-out infinite alternate;
    }
    .bg-blob-1 {
      width: 700px; height: 700px;
      background: radial-gradient(circle, var(--cobalt-light), var(--cobalt));
      top: -200px; right: -150px;
      animation-delay: 0s;
    }
    .bg-blob-2 {
      width: 500px; height: 500px;
      background: radial-gradient(circle, var(--sage-light), var(--sage));
      bottom: 100px; left: -100px;
      animation-delay: -6s;
    }
    .bg-blob-3 {
      width: 400px; height: 400px;
      background: radial-gradient(circle, var(--cobalt-mid), transparent);
      top: 50%; left: 40%;
      animation-delay: -12s;
    }
    .bg-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(#0B476C--- /* 0.04 */ 1px, transparent 1px),
        linear-gradient(90deg, #0B476C--- /* 0.04 */ 1px, transparent 1px);
      background-size: 60px 60px;
    }
    @keyframes drift {
      from { transform: translate(0, 0) scale(1); }
      to   { transform: translate(40px, 30px) scale(1.08); }
    }
  </style>
